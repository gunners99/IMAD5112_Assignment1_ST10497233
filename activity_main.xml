<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Header Card (Google, 2023. CardView. Android Developers. Available at: https://developer.android.com/reference/androidx/cardview/widget/CardView [Accessed 30 March 2026]) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/headerCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨"
                    android:textSize="48sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Social Sparks"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stay connected, one spark at a time 💫"
                    android:textSize="14sp"
                    android:textColor="@color/headerSubtitle"
                    android:layout_marginTop="6dp"
                    android:gravity="center"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Input Card (Google, 2023. EditText. Android Developers. Available at: https://developer.android.com/reference/android/widget/EditText [Accessed 30 March 2026]) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What time of day is it? 🕐"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/labelText"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etTimeOfDay"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="e.g. Morning, Afternoon, Evening..."
                    android:textSize="15sp"
                    android:textColor="@color/inputText"
                    android:textColorHint="@color/hintText"
                    android:background="@drawable/input_background"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:maxLines="1"
                    android:layout_marginBottom="16dp"/>

                <!-- Times hint (Google, 2023. TextView. Android Developers. Available at: https://developer.android.com/reference/android/widget/TextView [Accessed 30 March 2026]) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Try: Morning · Mid-Morning · Afternoon · Snack Time · Dinner · Evening"
                    android:textSize="11sp"
                    android:textColor="@color/hintText"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Buttons Row (Google, 2023. Material Components Button. Android Developers. Available at: https://developer.android.com/reference/com/google/android/material/button/MaterialButton [Accessed 30 March 2026]) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnGetSpark"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="2"
                android:layout_marginEnd="8dp"
                android:text="✨ Get My Spark!"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/primaryButton"
                android:stateListAnimator="@null"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="↺ Reset"
                android:textSize="14sp"
                android:textColor="@color/resetText"
                android:backgroundTint="@color/resetButton"
                android:stateListAnimator="@null"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        </LinearLayout>

        <!-- Spark Result Card (Google, 2023. CardView. Android Developers. Available at: https://developer.android.com/reference/androidx/cardview/widget/CardView [Accessed 30 March 2026]) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSpark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/sparkCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvSparkLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ Your Social Spark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/sparkLabel"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/tvEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="52sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvSpark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/sparkText"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.4"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Footer (Google, 2023. TextView. Android Developers. Available at: https://developer.android.com/reference/android/widget/TextView [Accessed 30 March 2026]) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Made with ❤️ for Cora"
            android:textSize="12sp"
            android:textColor="@color/footerText"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"/>

    </LinearLayout>
</ScrollView>
